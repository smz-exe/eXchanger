{
    "name": "exchanger",
    "version": "1.0.0",
    "main": "dist/index.js",
    "type": "commonjs",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc",
        "start": "node dist/index.js",
        "deploy-commands": "tsx src/deploy-commands.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "author": "smz-exe",
    "license": "ISC",
    "description": "Discord bot for attendance tracking and virtual currency (Jam).",
    "dependencies": {
        "@google/genai": "^2.10.0",
        "date-fns": "^4.4.0",
        "discord.js": "^14.26.4",
        "dotenv": "^17.4.2",
        "pg": "^8.22.0",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.8",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@types/pg": "^8.20.0",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^10.6.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "undici": "^6.27.0",
        "ws": "^8.21.0",
        "validator": "^13.15.35",
        "lodash": "^4.18.1",
        "dottie": "^2.0.7",
        "uuid": "^11.1.1",
        "underscore": "^1.13.8"
    }
}
